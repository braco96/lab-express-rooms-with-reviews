{{! Login form }}
{{#if errorMessage}}
<p style="color:red">{{errorMessage}}</p>
{{/if}}
<form method="POST" action="/login">
  <label>Email: <input type="email" name="email" /></label><br />
  <label>Password: <input type="password" name="password" /></label><br />
  <button type="submit">Login</button>
</form>
